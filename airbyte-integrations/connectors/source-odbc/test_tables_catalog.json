{
  "streams": [
    {
      "stream": {
        "name": "tables",
        "json_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "object_id": {"type": "integer"},
            "schema_name": {"type": "string"},
            "table_name": {"type": "string"},
            "full_table_name": {"type": "string"},
            "table_type": {"type": "string"},
            "create_date": {"type": ["string", "null"]},
            "modify_date": {"type": ["string", "null"]},
            "row_count": {"type": ["integer", "null"]},
            "has_clustered_index": {"type": "boolean"},
            "has_primary_key": {"type": "boolean"},
            "is_replicated": {"type": "boolean"},
            "is_published": {"type": "boolean"},
            "data_compression_desc": {"type": ["string", "null"]}
          }
        },
        "supported_sync_modes": ["full_refresh"],
        "source_defined_primary_key": [["object_id"]]
      },
      "sync_mode": "full_refresh",
      "destination_sync_mode": "overwrite"
    }
  ]
}
