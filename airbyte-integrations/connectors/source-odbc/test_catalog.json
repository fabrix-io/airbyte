{
  "streams": [
    {
      "stream": {
        "name": "database_metadata",
        "json_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "database_name": {"type": "string"},
            "database_id": {"type": "integer"},
            "collation_name": {"type": ["string", "null"]},
            "create_date": {"type": ["string", "null"]},
            "compatibility_level": {"type": ["integer", "null"]},
            "state_desc": {"type": ["string", "null"]},
            "is_read_only": {"type": "boolean"},
            "is_auto_close_on": {"type": "boolean"},
            "is_auto_shrink_on": {"type": "boolean"},
            "recovery_model_desc": {"type": ["string", "null"]},
            "page_verify_option_desc": {"type": ["string", "null"]}
          }
        },
        "supported_sync_modes": ["full_refresh"],
        "source_defined_primary_key": [["database_name"]]
      },
      "sync_mode": "full_refresh",
      "destination_sync_mode": "overwrite"
    }
  ]
}
